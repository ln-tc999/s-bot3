# Copy to .env.local and fill in.

# Default chain when no wallet is connected: 968 testnet, 677 mainnet.
# Leave unset and it defaults to testnet. The header network switcher lets
# users flip at runtime regardless of this value.
NEXT_PUBLIC_CHAIN_ID=968

# Testnet (968) addresses — already known, used as fallback defaults.
NEXT_PUBLIC_REGISTRY_ADDRESS=
# TokenBook: the symbol to token bindings every vault settles against. Without
# it an index can be published and read, but never subscribed to.
NEXT_PUBLIC_TOKENBOOK_ADDRESS=

# Mainnet (677) addresses — required to enable the mainnet option in the
# network switcher. Leave unset to hide mainnet entirely.
NEXT_PUBLIC_MAINNET_REGISTRY_ADDRESS=
NEXT_PUBLIC_MAINNET_TOKENBOOK_ADDRESS=

# Optional RPC override. Unset falls back to the chain's public node.
NEXT_PUBLIC_RPC_URL=
