# Copy to .env.local and fill in.

# Which BOT Chain this deployment talks to: 968 testnet, 677 mainnet.
# Leave unset locally and it defaults to testnet.
NEXT_PUBLIC_CHAIN_ID=968

# Optional RPC override. Unset falls back to the chain's public node.
NEXT_PUBLIC_RPC_URL=

# SBot3Registry, written down after you deploy it.
NEXT_PUBLIC_REGISTRY_ADDRESS=

# TokenBook — the symbol to token bindings every vault settles against.
# Without it an index can be published and read, but never subscribed to.
NEXT_PUBLIC_TOKENBOOK_ADDRESS=
