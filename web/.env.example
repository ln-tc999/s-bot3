# Copy to .env.local and fill in.

# Which BOT Chain this deployment talks to: 968 testnet, 677 mainnet.
# Leave unset locally and it defaults to testnet.
NEXT_PUBLIC_CHAIN_ID=968

# Optional RPC override. Unset falls back to the chain's public node.
NEXT_PUBLIC_RPC_URL=

# SBot3Registry, written down after you deploy it in Remix.
NEXT_PUBLIC_REGISTRY_ADDRESS=

# MockERC20 quote token — the asset every vault settles in. Deploy it once,
# then paste it here. Without it the faucet and trading stay switched off.
NEXT_PUBLIC_QUOTE_ADDRESS=
